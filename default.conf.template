map $env_basic_auth_enabled $basic_auth_enabled {
  default 'off';
  '_1' 'Go Away';
}

server {
  real_ip_header X-Forwarded-For;
  set_real_ip_from 172.16.0.0/12;

  listen       80;
  server_name  localhost;

  proxy_buffering off;

  set $env_basic_auth_enabled _0;
  set $env_basic_auth_enabled _${BASIC_AUTH_ENABLED};

  include conf.d/custom.conf;

  location / {
    include conf.d/network.conf;

    proxy_pass http://127.0.0.1:${LOCAL_PORT};

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    error_page 502 /error/5xx.html;
    location /error/ {
      root /usr/share/nginx/html;
    }

    auth_basic $basic_auth_enabled;
    auth_basic_user_file /etc/nginx/.htpasswd;
  }
}
