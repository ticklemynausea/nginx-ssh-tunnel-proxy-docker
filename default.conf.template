map $env_basic_auth_enabled $basic_auth_enabled {
  default 'off';
  '_1' 'Go Away';
}

server {
  real_ip_header X-Forwarded-For;
  set_real_ip_from 172.16.0.0/12;

  listen       80;
  server_name  localhost;

  proxy_buffering off;

  set $env_basic_auth_enabled _0;
  set $env_basic_auth_enabled _${BASIC_AUTH_ENABLED};

  include conf.d/custom.conf;
  include conf.d/paths.inc;

  location / {
    include conf.d/proxy.inc;

    proxy_pass http://127.0.0.1:${LOCAL_PORT};

    location /error/ {
      root /usr/share/nginx/html;
    }
  }
}
